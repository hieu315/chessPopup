{
  "manifest_version": 3,
  "name": "Popup Gambit",
  "version": "0.1.0",
  "description": "Choi co vua voi Stockfish ngay trong popup cua Chrome.",
  "icons": {
    "16": "assets/icons/popup-gambit-16.png",
    "32": "assets/icons/popup-gambit-32.png",
    "48": "assets/icons/popup-gambit-48.png",
    "128": "assets/icons/popup-gambit-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "Popup Gambit",
    "default_icon": {
      "16": "assets/icons/popup-gambit-16.png",
      "32": "assets/icons/popup-gambit-32.png"
    },
    "default_popup": "popup/popup.html"
  }
}
